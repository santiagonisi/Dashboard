# Copiar este archivo a .env y reemplazar con valores reales
# NO SUBIR .env A GIT, solo .env.example

# Entorno Flask
FLASK_ENV=production
FLASK_DEBUG=0
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# Seguridad de sesión
SECRET_KEY=CAMBIAR_ESTA_CLAVE_EN_PRODUCCION
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_MINUTES=480

# Servidor Waitress (intranet)
APP_HOST=0.0.0.0
APP_PORT=8080
APP_THREADS=8
